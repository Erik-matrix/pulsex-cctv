// The window, taskbar and Explorer icon.
1 ICON "cctv.ico"

// 09-30: version resource (Explorer > Properties > Details; also the app's name for Windows)
1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PulseCore"
      VALUE "FileDescription", "PulseX CCTV"
      VALUE "FileVersion", "0.4"
      VALUE "ProductName", "PulseX CCTV"
      VALUE "ProductVersion", "0.4"
      VALUE "OriginalFilename", "pulsex_cctv.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
